#!/sbin/sh
# Module installer entry for Magisk, KernelSU and APatch
umask 022
OUTFD=$2
ZIPFILE=$3
ui_print() { printf 'ui_print %s\n' "$1" > /proc/self/fd/$OUTFD; }
abort()    { ui_print "$1"; exit 1; }

[ -f /data/adb/magisk/util_functions.sh ] || abort "! Install from Magisk, KernelSU or APatch"
. /data/adb/magisk/util_functions.sh
install_module
exit 0
